# Copy this file to .env and fill in your own values. Never commit .env!
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
JWT_SECRET=<long random string>
GOOGLE_GENAI_API_KEY=<key from https://aistudio.google.com/apikey>

# Optional
# PORT=3000
# CLIENT_URL=http://localhost:5173
# GEMINI_MODEL=gemini-3-flash-preview
# AUTH_RATE_LIMIT=50
# AI_RATE_LIMIT=60
# NODE_ENV=production
