{
  "info": {
    "name": "HireMate API",
    "description": "All HireMate routes. Log in first \u2013 Postman keeps the httpOnly `token` cookie automatically. Set `reportId` in the collection variables to a report _id from MongoDB Compass or from 'Get all reports'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "reportId",
      "value": ""
    },
    {
      "key": "shareId",
      "value": ""
    }
  ],
  "item": [
