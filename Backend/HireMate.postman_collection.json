    {
      "name": "Interview",
      "item": [
        {
          "name": "Generate report",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/interview/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "interview"
              ]
            },
            "description": "",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "jobDescription",
                  "value": "Paste job description here",
                  "type": "text"
                },
                {
                  "key": "selfDescription",
                  "value": "Short self description (optional if resume uploaded)",
                  "type": "text"
                },
                {
                  "key": "companyName",
                  "value": "Google",
                  "type": "text",
                  "description": "NEW, optional"
                },
                {
                  "key": "resume",
                  "type": "file",
                  "src": [],
                  "description": "PDF, max 5MB (optional if selfDescription given)"
                }
              ]
            }
          }
        },
